+def smoke(args):
+    """Two user-required v2 end-to-end checks; excluded from formal records."""
+    topo=topology()
+    assert topo['hostname']=='cpunode-029'
+    os.sched_setaffinity(0,[topo['controller_domain']['cpu']])
+    old=Path('/tmp/prusie_bench_20261028_700768_cpunode-029')
+    if old.exists():
+        recovery=DATA/'formal_results/cpunode-029/700768/.protocol_amendment_aborts'
+        recovery.mkdir(parents=True,exist_ok=True)
+        for partial in (old/'cases').glob('*'):
+            if (partial/'input').exists():shutil.rmtree(partial/'input')
+            dest=recovery/partial.name
+            assert not dest.exists(),str(dest)
+            shutil.copytree(partial,dest)
+        shutil.rmtree(old)
+    archive=DATA/'smoke_v2'/os.environ['SLURM_JOB_ID'];archive.mkdir(parents=True,exist_ok=True)
+    base=Path('/tmp')/('prusie_v2_smoke_'+os.environ['SLURM_JOB_ID'])
+    base.mkdir()
+    manifest=read(RUN/'inputs/campaign_manifest.json')
+    selected=[min((r for r in manifest['rows'] if r['panel']==p),key=lambda r:(r['p'],r['case_key'])) for p in ('GWAS','eQTL')]
+    plan=read(RUN/'campaign_plan.json')
+    tasks={t['case_key']:t for sh in plan['shards'] for t in sh['tasks']}
+    protocol_sha=sha(RUN/'protocol.json');outcomes=[]
+    try:
+        manifest,verification=stage(manifest,selected,base)
+        lane=topo['lanes'][0]
+        for row in selected:
+            out=base/'cases'/row['case_key'];out.mkdir(parents=True)
+            minimal={k:manifest[k] for k in ('_inputs_root','_manifest_sha256','validation_tolerances')}
+            minimal.update(rows=[],references={row['reference_key']:manifest['references'][row['reference_key']]})
+            receipt=dict(verification,records=[r for r in verification['records'] if r['key']==row['reference_key']])
+            execution=dict(row=row,task=tasks[row['case_key']],manifest=minimal,verification=receipt,protocol_sha256=protocol_sha,
+                placement=dict(cpus=[lane['cpu']],numa=lane['numa'],socket=lane['socket'],l3_cpus=lane['l3_cpus'],binding='membind'))
+            write(out/'execution.json',execution)
+            argv=['taskset','--cpu-list',','.join(map(str,topo['allowed_cpus'])),'numactl',f"--membind={lane['numa']}",f"--physcpubind={lane['cpu']}",str(RUN/'envs/native/bin/python'),'-B',str(Path(__file__).resolve()),'case','--request',str(out/'execution.json')]
+            with (out/'worker.log').open('w') as log:
+                rc=subprocess.run(argv,stdout=log,stderr=subprocess.STDOUT).returncode
+            shutil.copytree(out,archive/row['case_key'])
+            assert rc==0 and read(out/'result.json')['state']=='COMPLETE',str(out)
+            for backend in ('R','prusie'):
+                samples=read(out/(backend+'.json'))['samples']
+                assert len(samples)==4 and sum(s['warmup'] for s in samples)==1
+                assert all(s['validity_pass'] and 0<s['fitting'].get('fitting_seconds',s['fitting'].get('fit_seconds'))<=s['time_seconds'] for s in samples)
+            outcomes.append(dict(case_key=row['case_key'],p=row['p'],state='PASS'))
+        write(DATA/'smoke_v2/PASS.json',dict(state='PASS',protocol_sha256=protocol_sha,cases=outcomes,job_id=os.environ['SLURM_JOB_ID'],formal_timing_result=False,epoch=time.time()))
+    finally:
+        if base.exists():shutil.rmtree(base)
+        os.sched_setaffinity(0,topo['allowed_cpus'])
