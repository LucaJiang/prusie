+// Run-local benchmark instrumentation only. Scientific outputs are unchanged.
+std::thread_local! {
+    static BENCHMARK_FIT_NANOSECONDS: std::cell::Cell<u128> = const { std::cell::Cell::new(0) };
+}
+pub fn benchmark_timing_reset() {
+    BENCHMARK_FIT_NANOSECONDS.with(|value| value.set(0));
+}
+pub fn benchmark_timing_add(nanoseconds: u128) {
+    BENCHMARK_FIT_NANOSECONDS.with(|value| value.set(value.get() + nanoseconds));
+}
+pub fn benchmark_timing_seconds() -> f64 {
+    BENCHMARK_FIT_NANOSECONDS.with(|value| value.get() as f64 / 1e9)
+}
